# Copy to .env.local. Placeholders only: no secrets belong in this file.
# "mock" = development-only in-memory data. "api" = call the real backend.
NEXT_PUBLIC_DATA_SOURCE=mock
# Base URL of the backend API (to be provided by the backend developer).
NEXT_PUBLIC_API_BASE_URL=

# Database: SQLite file for development. Use a PostgreSQL URL (and provider = "postgresql" in prisma/schema.prisma) in production.
DATABASE_URL=file:./prisma/dev.db
# Production (Neon): the pooled connection string. DIRECT_URL is the unpooled one, used only to create tables.
# DIRECT_URL=

# E-mail through Brevo (free plan: 300 a day). Leave empty to keep mail in the Outbox table only.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=ZAQSA
