// Multi-tenant School ERP data model.
// Shared database, shared schema: every tenant-owned table carries tenantId, and every query in
// src/server must go through tenantDb(tenantId) so rows can never cross schools.
// Strings are used instead of enums so the same schema runs on SQLite (dev) and PostgreSQL (prod).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Global reference data (not tenant-owned) ----------

model Board {
  id         String        @id @default(cuid())
  code       String        @unique // CBSE, ICSE, ISC, IB, CAMBRIDGE, NIOS, STATE-MH ...
  name       String
  kind       String // national | international | open | state
  stateCode  String? // for state boards
  gradeScale String // JSON: [{name,from,to,remark,points}]
  schools    TenantBoard[]
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  kind      String // state | ut
  districts District[]
}

model District {
  id      String @id @default(cuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])

  @@unique([stateId, name])
}

// ---------- Tenancy ----------

model Tenant {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  status       String    @default("provisioned") // provisioned | live | suspended
  plan         String    @default("trial")
  planPeriod   String    @default("monthly") // monthly | yearly
  /// trial | active | past_due | restricted | cancelled. Derived from periodEnd + graceDays when active.
  subscription String    @default("trial")
  periodEnd    DateTime? // end of the paid (or trial) period
  graceDays    Int       @default(7)
  wentLiveAt   DateTime?
  maxStudents  Int? // plan limit on active students; null = no limit
  udiseCode    String? // optional UDISE+ school code
  phone        String?
  email        String?
  address      String?
  stateId      String?
  districtId   String?
  timezone     String    @default("Asia/Kolkata")
  createdAt    DateTime  @default(now())

  boards       TenantBoard[]
  campuses     Campus[]
  users        Membership[]
  years        AcademicYear[]
  classes      ClassLevel[]
  students     Student[]
  guardians    Guardian[]
  staff        Staff[]
  bellSlots    BellSlot[]
  homework     Homework[]
  books        Book[]
  vehicles     Vehicle[]
  certificates Certificate[]
  routes       TransportRoute[]
  loans        Loan[]
  periods      Period[]
  subjects     Subject[]
  feeHeads     FeeHead[]
  bank         TenantBank?
  invoices     Invoice[]
  notices      Notice[]
  exams        Exam[]
  auditLogs    AuditLog[]
  admissions   Admission[]
  tickets      SupportTicket[]
}

model TenantBoard {
  tenantId   String
  boardId    String
  isDefault  Boolean @default(false) // the board whose grading applies when an exam names none
  gradeScale String? // school override (JSON); null = the board default
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  board      Board   @relation(fields: [boardId], references: [id])

  @@id([tenantId, boardId])
}

model Campus {
  id       String       @id @default(cuid())
  tenantId String
  name     String
  address  String?
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes  ClassLevel[]

  @@index([tenantId])
}

// ---------- Identity ----------

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean         @default(false)
  /// ZAQSA staff role (super_admin, sales, support, ...). Null on a platform user means super_admin.
  platformRole    String?
  active          Boolean         @default(true)
  totpCipher      String? // authenticator secret, encrypted (src/server/secret.ts)
  totpEnabled     Boolean         @default(false)
  totpLastStep    Int             @default(0) // last accepted 30-second step, so a code works once
  createdAt       DateTime        @default(now())
  memberships     Membership[]
  sessions        Session[]
  tokens          PasswordToken[]
}

// A user can belong to several schools with a role in each.
model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     String // school_owner | principal | admin | teacher | accountant | librarian | transport | parent | student
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// Server-side sessions: the cookie holds only an opaque random token; we store its SHA-256.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  tenantId  String? // active school for this session
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Academics ----------

model AcademicYear {
  id       String    @id @default(cuid())
  tenantId String
  label    String // 2026-27
  startsOn DateTime
  endsOn   DateTime
  current  Boolean   @default(false)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  exams    Exam[]

  @@unique([tenantId, label])
}

model ClassLevel {
  id       String    @id @default(cuid())
  tenantId String
  campusId String?
  name     String // Nursery, LKG, UKG, Class 1 ... Class 12
  stage    String // pre-primary | primary | middle | secondary | senior-secondary
  position Int // ordering for promotion
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus   Campus?   @relation(fields: [campusId], references: [id])
  sections Section[]
  subjects Subject[]

  @@unique([tenantId, name])
}

model Section {
  id             String       @id @default(cuid())
  tenantId       String
  classId        String
  name           String
  classTeacherId String?
  class          ClassLevel   @relation(fields: [classId], references: [id], onDelete: Cascade)
  students       Student[]
  attendance     Attendance[]
  periods        Period[]
  homework       Homework[]

  @@unique([classId, name])
  @@index([tenantId])
}

model Subject {
  id       String     @id @default(cuid())
  tenantId String
  classId  String
  name     String
  code     String?
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class    ClassLevel @relation(fields: [classId], references: [id], onDelete: Cascade)
  marks    Mark[]
  periods  Period[]
  homework Homework[]

  @@unique([classId, name])
  @@index([tenantId])
}

// ---------- People ----------

model Student {
  id            String            @id @default(cuid())
  tenantId      String
  admissionNo   String
  name          String
  dob           DateTime?
  gender        String?
  sectionId     String?
  guardianId    String?
  bloodGroup    String?
  category      String? // General | OBC | SC | ST | EWS (as declared)
  motherTongue  String?
  religion      String?
  aadhaarLast4  String? // never store the full Aadhaar number
  penNumber     String? // Permanent Education Number
  apaarId       String?
  stateId       String?
  districtId    String?
  address       String?
  status        String            @default("active") // active | alumni | transferred
  userId        String? // login of the student, when they have one
  importBatchId String? // set when the student came from a bulk import (allows undo)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section       Section?          @relation(fields: [sectionId], references: [id])
  guardian      Guardian?         @relation(fields: [guardianId], references: [id])
  attendance    Attendance[]
  marks         Mark[]
  invoices      Invoice[]
  homeworkRows  HomeworkStatus[]
  loans         Loan[]
  transport     StudentTransport?
  certificates  Certificate[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId, sectionId])
}

model Guardian {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  relation String // father | mother | guardian
  phone    String?
  email    String?
  userId   String? // login of this guardian (role parent); links parents to their children
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([userId])
  @@index([tenantId])
}

model Staff {
  id            String           @id @default(cuid())
  tenantId      String
  employeeNo    String // EMP-<year>-0001, generated
  name          String
  role          String // teacher | accountant | admin | librarian | driver | other
  designation   String?
  department    String?
  qualification String?
  phone         String?
  email         String?
  joinedOn      DateTime?
  status        String           @default("active") // active | inactive
  userId        String? // login of this staff member, when they have one
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periods       Period[]
  loans         Loan[]
  routes        TransportRoute[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
  @@index([userId])
}

// ---------- Timetable ----------

// The school's bell schedule: slot 1..12 with clock times (HH:MM, 24h).
model BellSlot {
  id       String  @id @default(cuid())
  tenantId String
  slot     Int
  label    String
  startsAt String
  endsAt   String
  isBreak  Boolean @default(false)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slot])
}

// One lesson. day: 1 = Monday ... 7 = Sunday. The unique indexes make double-booking a section
// or a teacher impossible even under concurrent writes.
model Period {
  id        String  @id @default(cuid())
  tenantId  String
  sectionId String
  day       Int
  slot      Int
  subjectId String
  staffId   String?
  room      String?
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff     Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([sectionId, day, slot])
  @@unique([tenantId, staffId, day, slot])
  @@index([tenantId])
}

// ---------- Attendance and exams ----------

model Attendance {
  id        String   @id @default(cuid())
  tenantId  String
  sectionId String
  studentId String
  date      DateTime
  status    String // present | absent | late | leave
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId, sectionId, date])
}

// One row per (section, date): tracks draft/submitted. Locked once submitted unless a principal reopens.
model AttendanceSheet {
  id          String    @id @default(cuid())
  tenantId    String
  sectionId   String
  date        DateTime
  status      String    @default("draft") // draft | submitted
  submittedBy String?
  submittedAt DateTime?

  @@unique([sectionId, date])
  @@index([tenantId])
}

// One row per (exam, section, subject): tracks draft/submitted for mark entry.
model MarkSheet {
  id        String @id @default(cuid())
  tenantId  String
  examId    String
  sectionId String
  subjectId String
  status    String @default("draft")

  @@unique([examId, sectionId, subjectId])
  @@index([tenantId])
}

model Exam {
  id           String       @id @default(cuid())
  tenantId     String
  yearId       String
  name         String // Term 1, Unit Test 2, Half-yearly ...
  maxMarks     Int          @default(100)
  passPercent  Int          @default(33)
  approvedAt   DateTime? // a principal must approve the marks before they can be published
  approvedById String?
  published    Boolean      @default(false) // results are visible to parents/students only once published
  publishedAt  DateTime?
  boardId      String? // grading scale to apply; null = tenant default board
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year         AcademicYear @relation(fields: [yearId], references: [id])
  marks        Mark[]

  @@index([tenantId])
}

model Mark {
  id        String  @id @default(cuid())
  tenantId  String
  examId    String
  subjectId String
  studentId String
  score     Float?
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId, studentId])
  @@index([tenantId])
}

// ---------- Fees (amounts are stored in paise: integers, never floats) ----------

model FeeHead {
  id         String @id @default(cuid())
  tenantId   String
  name       String // Tuition, Transport, Exam, Lab ...
  gstPercent Int    @default(0) // most school education is exempt; configurable per head
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Invoice {
  id             String       @id @default(cuid())
  tenantId       String
  yearId         String
  studentId      String
  number         String
  title          String
  amountPaise    Int // what is payable, after any discount
  grossPaise     Int? // before discount, when one was applied
  discountPaise  Int          @default(0)
  discountReason String?
  dueOn          DateTime
  createdAt      DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year           AcademicYear @relation(fields: [yearId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
}

model Payment {
  id               String   @id @default(cuid())
  tenantId         String
  invoiceId        String
  amountPaise      Int
  mode             String // cash | upi | cheque | dd | netbanking | card
  reference        String? // UPI txn id, cheque no. ...
  gatewayPaymentId String?  @unique // set when the payment came from a verified gateway callback
  receiptNo        String? // assigned when a receipt is first issued
  paidOn           DateTime @default(now())
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNo])
  @@index([tenantId, invoiceId])
}

// ---------- Communication and audit ----------

model Notice {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  body        String
  audience    String    @default("all")
  status      String    @default("draft") // draft | published
  authorName  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  userId   String?
  action   String
  entity   String
  entityId String?
  at       DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
}

// Admission pipeline: new -> documents -> review -> decision -> enrolled | declined.
// "enrolled" is only reached through the admit endpoint, which creates the Student.
model Admission {
  id            String    @id @default(cuid())
  tenantId      String
  studentName   String
  dob           DateTime?
  gender        String?
  applyingForId String? // ClassLevel id
  guardianName  String
  guardianPhone String
  guardianEmail String?
  source        String    @default("walk-in") // walk-in | website | referral | phone | other
  stage         String    @default("new")
  notes         String?
  studentId     String?   @unique // set once enrolled
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stage])
}

// ---------- Homework ----------

model Homework {
  id          String           @id @default(cuid())
  tenantId    String
  sectionId   String
  subjectId   String
  title       String
  description String
  assignedOn  DateTime
  dueOn       DateTime
  status      String // draft | published | withdrawn
  createdById String // User.id of the author
  authorName  String
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  rows        HomeworkStatus[]

  @@index([tenantId, sectionId, dueOn])
}

// Per-student completion, recorded by the teacher. A student with no row is "pending".
model HomeworkStatus {
  id         String   @id @default(cuid())
  tenantId   String
  homeworkId String
  studentId  String
  status     String // done | missing | excused
  note       String?
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([tenantId])
}

// ---------- Library ----------

model Book {
  id              String   @id @default(cuid())
  tenantId        String
  accessionNo     String // LIB-0001, generated
  title           String
  author          String
  isbn            String?
  category        String
  shelf           String?
  totalCopies     Int
  availableCopies Int // decremented atomically on issue, so the last copy can never be issued twice
  status          String   @default("active") // active | retired
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans           Loan[]

  @@unique([tenantId, accessionNo])
  @@unique([tenantId, isbn])
  @@index([tenantId])
}

// One borrowing. Exactly one of studentId / staffId is set. Fines are stored in paise.
model Loan {
  id         String    @id @default(cuid())
  tenantId   String
  bookId     String
  studentId  String?
  staffId    String?
  issuedOn   DateTime
  dueOn      DateTime
  returnedOn DateTime?
  finePaise  Int       @default(0)
  fineStatus String    @default("none") // none | due | paid | waived
  issuedById String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff      Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([tenantId, staffId])
  @@index([bookId])
}

// ---------- Transport ----------

model Vehicle {
  id              String           @id @default(cuid())
  tenantId        String
  regNo           String // normalised, e.g. KA01AB1234
  type            String // bus | van
  capacity        Int
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  status          String           @default("active") // active | inactive
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routes          TransportRoute[]

  @@unique([tenantId, regNo])
}

// A vehicle and a driver can each serve only one route (database-enforced).
model TransportRoute {
  id              String             @id @default(cuid())
  tenantId        String
  name            String
  vehicleId       String?
  driverId        String?
  attendantName   String?
  monthlyFeePaise Int                @default(0) // informational; not invoiced automatically
  status          String             @default("active") // active | inactive
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver          Staff?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  stops           RouteStop[]
  riders          StudentTransport[]

  @@unique([tenantId, name])
  @@unique([tenantId, vehicleId])
  @@unique([tenantId, driverId])
}

model RouteStop {
  id         String             @id @default(cuid())
  tenantId   String
  routeId    String
  name       String
  sequence   Int
  pickupTime String // HH:MM
  dropTime   String?
  route      TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  riders     StudentTransport[]

  @@unique([routeId, name])
  @@index([tenantId])
}

// A student uses at most one route and stop.
model StudentTransport {
  id        String         @id @default(cuid())
  tenantId  String
  studentId String         @unique
  routeId   String
  stopId    String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop      RouteStop      @relation(fields: [stopId], references: [id], onDelete: Restrict)

  @@index([tenantId, routeId])
}

// ---------- Certificates ----------

// A request becomes an issued certificate only when the principal issues it. The student's details
// are copied into `data` at that moment, so later edits never change a certificate already issued.
model Certificate {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  type            String // bonafide | character | transfer
  status          String // requested | issued | rejected | cancelled
  purpose         String?
  requestedById   String
  requestedByName String
  serialNo        String? // BON/2026/0001, set when issued
  issuedOn        DateTime?
  issuedByName    String?
  data            String? // JSON snapshot
  decisionNote    String? // reason for rejecting or cancelling
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serialNo])
  @@index([tenantId, studentId])
}

// ---------- Accounts ----------

// One-time links for setting or resetting a password. Only the SHA-256 of the token is stored.
model PasswordToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String // reset | invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Every e-mail the system sends. With no mail provider configured this is the only delivery:
// development reads it back; production needs a real provider (see docs/BACKEND.md).
model Outbox {
  id        String    @id @default(cuid())
  tenantId  String?
  toEmail   String
  subject   String
  body      String
  /// stored (no provider set) | sent | failed
  status    String    @default("stored")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([toEmail])
}

// ---------- Platform: bank details, imports, online payments, ledger ----------

/// Where ZAQSA pays the school out. The account number is stored encrypted (see src/server/secret.ts).
model TenantBank {
  tenantId      String   @id
  holderName    String
  bankName      String
  ifsc          String
  accountLast4  String
  accountCipher String // AES-256-GCM: iv.tag.ciphertext (base64url)
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// A bulk import. Rows are checked first (status preview), then committed, and can be undone.
model ImportBatch {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String // students
  status     String   @default("preview") // preview | committed | undone
  rowsJson   String // valid rows, ready to commit
  errorsJson String // rows that failed validation
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

/// One attempt by a parent to pay an invoice online. Only a verified gateway callback marks it paid.
model PaymentAttempt {
  id             String   @id @default(cuid())
  tenantId       String
  invoiceId      String
  amountPaise    Int
  gateway        String // razorpay | stub
  gatewayOrderId String   @unique
  status         String   @default("created") // created | paid | failed
  createdAt      DateTime @default(now())

  @@index([tenantId, invoiceId])
}

/// Each gateway callback is stored once (by its event id) so a retried callback cannot post twice.
model WebhookEvent {
  id         String   @id @default(cuid())
  gateway    String
  eventId    String
  type       String
  receivedAt DateTime @default(now())

  @@unique([gateway, eventId])
}

/// Money movements per school, separate from gateway records. Positive = collected for the school.
model LedgerEntry {
  id             String   @id @default(cuid())
  tenantId       String
  kind           String // fee_collected | gateway_fee | refund | payout
  amountPaise    Int
  refType        String
  refId          String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Remembers the result of a write sent with an Idempotency-Key, so a retry returns the same answer
/// instead of doing the work twice. A row with status 0 is still being processed.
model IdempotencyKey {
  id           String   @id @default(cuid())
  scope        String // tenant id, or "platform"
  operation    String
  key          String
  requestHash  String
  status       Int      @default(0)
  responseJson String   @default("")
  createdAt    DateTime @default(now())

  @@unique([scope, operation, key])
}

/// A refund of (part of) a payment. Needs a second person to approve; approval posts a negative payment.
model Refund {
  id            String    @id @default(cuid())
  tenantId      String
  paymentId     String
  amountPaise   Int
  reason        String
  status        String    @default("requested") // requested | approved | rejected
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, status])
  @@index([paymentId])
}

/// One reminder sent for an overdue invoice, so the same family is not nagged every day.
model FeeReminder {
  id        String   @id @default(cuid())
  tenantId  String
  invoiceId String
  sentAt    DateTime @default(now())

  @@index([tenantId, invoiceId])
}

// ---------- ZAQSA core: catalog, CRM, provisioning, support ----------

model Product {
  key      String @id // school, hospital, business, campaign, social, web, app, ai, marketing
  name     String
  kind     String // software | service
  summary  String
  status   String @default("available") // available | coming_soon | retired
  position Int    @default(0)
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  organisation String?
  productKey   String?
  message      String?
  source       String   @default("website")
  stage        String   @default("new") // new | contacted | demo | proposal | won | lost
  ownerId      String? // ZAQSA staff member handling the lead
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stage])
}

model ProvisioningRequest {
  id            String    @id @default(cuid())
  productKey    String
  organisation  String
  contactEmail  String
  leadId        String?
  /// requested | verifying | approved | rejected | provisioned
  status        String    @default("requested")
  tenantId      String? // the workspace created for it (school product)
  note          String?
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
}

model SupportTicket {
  id          String          @id @default(cuid())
  number      Int             @unique
  tenantId    String
  requesterId String
  subject     String
  category    String          @default("question") // question | problem | billing | request
  priority    String          @default("normal") // low | normal | high | urgent
  status      String          @default("open") // open | pending | resolved | closed
  assigneeId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]

  @@index([tenantId])
  @@index([status])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  authorId  String
  fromStaff Boolean       @default(false)
  /// Internal notes are visible to ZAQSA staff only.
  internal  Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
