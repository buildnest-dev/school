// Multi-tenant School ERP data model.
// Shared database, shared schema: every tenant-owned table carries tenantId, and every query in
// src/server must go through tenantDb(tenantId) so rows can never cross schools.
// Strings are used instead of enums so the same schema runs on SQLite (dev) and PostgreSQL (prod).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Global reference data (not tenant-owned) ----------

model Board {
  id         String        @id @default(cuid())
  code       String        @unique // CBSE, ICSE, ISC, IB, CAMBRIDGE, NIOS, STATE-MH ...
  name       String
  kind       String // national | international | open | state
  stateCode  String? // for state boards
  gradeScale String // JSON: [{name,from,to,remark,points}]
  schools    TenantBoard[]
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  kind      String // state | ut
  districts District[]
}

model District {
  id      String @id @default(cuid())
  name    String
  stateId String
  state   State  @relation(fields: [stateId], references: [id])

  @@unique([stateId, name])
}

// ---------- Tenancy ----------

model Tenant {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  status     String   @default("active") // trial | active | suspended
  plan       String   @default("trial")
  udiseCode  String? // optional UDISE+ school code
  phone      String?
  email      String?
  address    String?
  stateId    String?
  districtId String?
  timezone   String   @default("Asia/Kolkata")
  createdAt  DateTime @default(now())

  boards     TenantBoard[]
  campuses   Campus[]
  users      Membership[]
  years      AcademicYear[]
  classes    ClassLevel[]
  students   Student[]
  guardians  Guardian[]
  staff      Staff[]
  bellSlots  BellSlot[]
  homework   Homework[]
  periods    Period[]
  subjects   Subject[]
  feeHeads   FeeHead[]
  invoices   Invoice[]
  notices    Notice[]
  exams      Exam[]
  auditLogs  AuditLog[]
  admissions Admission[]
}

model TenantBoard {
  tenantId   String
  boardId    String
  isDefault  Boolean @default(false) // the board whose grading applies when an exam names none
  gradeScale String? // school override (JSON); null = the board default
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  board      Board   @relation(fields: [boardId], references: [id])

  @@id([tenantId, boardId])
}

model Campus {
  id       String       @id @default(cuid())
  tenantId String
  name     String
  address  String?
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes  ClassLevel[]

  @@index([tenantId])
}

// ---------- Identity ----------

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String
  isPlatformAdmin Boolean      @default(false)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  memberships     Membership[]
  sessions        Session[]
}

// A user can belong to several schools with a role in each.
model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     String // school_owner | principal | admin | teacher | accountant | librarian | transport | parent | student
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// Server-side sessions: the cookie holds only an opaque random token; we store its SHA-256.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  tenantId  String? // active school for this session
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Academics ----------

model AcademicYear {
  id       String    @id @default(cuid())
  tenantId String
  label    String // 2026-27
  startsOn DateTime
  endsOn   DateTime
  current  Boolean   @default(false)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  exams    Exam[]

  @@unique([tenantId, label])
}

model ClassLevel {
  id       String    @id @default(cuid())
  tenantId String
  campusId String?
  name     String // Nursery, LKG, UKG, Class 1 ... Class 12
  stage    String // pre-primary | primary | middle | secondary | senior-secondary
  position Int // ordering for promotion
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus   Campus?   @relation(fields: [campusId], references: [id])
  sections Section[]
  subjects Subject[]

  @@unique([tenantId, name])
}

model Section {
  id             String       @id @default(cuid())
  tenantId       String
  classId        String
  name           String
  classTeacherId String?
  class          ClassLevel   @relation(fields: [classId], references: [id], onDelete: Cascade)
  students       Student[]
  attendance     Attendance[]
  periods        Period[]
  homework       Homework[]

  @@unique([classId, name])
  @@index([tenantId])
}

model Subject {
  id       String     @id @default(cuid())
  tenantId String
  classId  String
  name     String
  code     String?
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class    ClassLevel @relation(fields: [classId], references: [id], onDelete: Cascade)
  marks    Mark[]
  periods  Period[]
  homework Homework[]

  @@unique([classId, name])
  @@index([tenantId])
}

// ---------- People ----------

model Student {
  id           String           @id @default(cuid())
  tenantId     String
  admissionNo  String
  name         String
  dob          DateTime?
  gender       String?
  sectionId    String?
  guardianId   String?
  bloodGroup   String?
  category     String? // General | OBC | SC | ST | EWS (as declared)
  motherTongue String?
  religion     String?
  aadhaarLast4 String? // never store the full Aadhaar number
  penNumber    String? // Permanent Education Number
  apaarId      String?
  stateId      String?
  districtId   String?
  address      String?
  status       String           @default("active") // active | alumni | transferred
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section      Section?         @relation(fields: [sectionId], references: [id])
  guardian     Guardian?        @relation(fields: [guardianId], references: [id])
  attendance   Attendance[]
  marks        Mark[]
  invoices     Invoice[]
  homeworkRows HomeworkStatus[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId, sectionId])
}

model Guardian {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  relation String // father | mother | guardian
  phone    String?
  email    String?
  userId   String? // login of this guardian (role parent); links parents to their children
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([userId])
  @@index([tenantId])
}

model Staff {
  id            String    @id @default(cuid())
  tenantId      String
  employeeNo    String // EMP-<year>-0001, generated
  name          String
  role          String // teacher | accountant | admin | librarian | driver | other
  designation   String?
  department    String?
  qualification String?
  phone         String?
  email         String?
  joinedOn      DateTime?
  status        String    @default("active") // active | inactive
  userId        String? // login of this staff member, when they have one
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periods       Period[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
  @@index([userId])
}

// ---------- Timetable ----------

// The school's bell schedule: slot 1..12 with clock times (HH:MM, 24h).
model BellSlot {
  id       String  @id @default(cuid())
  tenantId String
  slot     Int
  label    String
  startsAt String
  endsAt   String
  isBreak  Boolean @default(false)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slot])
}

// One lesson. day: 1 = Monday ... 7 = Sunday. The unique indexes make double-booking a section
// or a teacher impossible even under concurrent writes.
model Period {
  id        String  @id @default(cuid())
  tenantId  String
  sectionId String
  day       Int
  slot      Int
  subjectId String
  staffId   String?
  room      String?
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff     Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([sectionId, day, slot])
  @@unique([tenantId, staffId, day, slot])
  @@index([tenantId])
}

// ---------- Attendance and exams ----------

model Attendance {
  id        String   @id @default(cuid())
  tenantId  String
  sectionId String
  studentId String
  date      DateTime
  status    String // present | absent | late | leave
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId, sectionId, date])
}

// One row per (section, date): tracks draft/submitted. Locked once submitted unless a principal reopens.
model AttendanceSheet {
  id          String    @id @default(cuid())
  tenantId    String
  sectionId   String
  date        DateTime
  status      String    @default("draft") // draft | submitted
  submittedBy String?
  submittedAt DateTime?

  @@unique([sectionId, date])
  @@index([tenantId])
}

// One row per (exam, section, subject): tracks draft/submitted for mark entry.
model MarkSheet {
  id        String @id @default(cuid())
  tenantId  String
  examId    String
  sectionId String
  subjectId String
  status    String @default("draft")

  @@unique([examId, sectionId, subjectId])
  @@index([tenantId])
}

model Exam {
  id          String       @id @default(cuid())
  tenantId    String
  yearId      String
  name        String // Term 1, Unit Test 2, Half-yearly ...
  maxMarks    Int          @default(100)
  passPercent Int          @default(33)
  published   Boolean      @default(false) // results are visible to parents/students only once published
  publishedAt DateTime?
  boardId     String? // grading scale to apply; null = tenant default board
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year        AcademicYear @relation(fields: [yearId], references: [id])
  marks       Mark[]

  @@index([tenantId])
}

model Mark {
  id        String  @id @default(cuid())
  tenantId  String
  examId    String
  subjectId String
  studentId String
  score     Float?
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId, studentId])
  @@index([tenantId])
}

// ---------- Fees (amounts are stored in paise: integers, never floats) ----------

model FeeHead {
  id         String @id @default(cuid())
  tenantId   String
  name       String // Tuition, Transport, Exam, Lab ...
  gstPercent Int    @default(0) // most school education is exempt; configurable per head
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Invoice {
  id          String       @id @default(cuid())
  tenantId    String
  yearId      String
  studentId   String
  number      String
  title       String
  amountPaise Int
  dueOn       DateTime
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year        AcademicYear @relation(fields: [yearId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  amountPaise Int
  mode        String // cash | upi | cheque | dd | netbanking | card
  reference   String? // UPI txn id, cheque no. ...
  paidOn      DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

// ---------- Communication and audit ----------

model Notice {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  body        String
  audience    String    @default("all")
  status      String    @default("draft") // draft | published
  authorName  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  userId   String?
  action   String
  entity   String
  entityId String?
  at       DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
}

// Admission pipeline: new -> documents -> review -> decision -> enrolled | declined.
// "enrolled" is only reached through the admit endpoint, which creates the Student.
model Admission {
  id            String    @id @default(cuid())
  tenantId      String
  studentName   String
  dob           DateTime?
  gender        String?
  applyingForId String? // ClassLevel id
  guardianName  String
  guardianPhone String
  guardianEmail String?
  source        String    @default("walk-in") // walk-in | website | referral | phone | other
  stage         String    @default("new")
  notes         String?
  studentId     String?   @unique // set once enrolled
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stage])
}

// ---------- Homework ----------

model Homework {
  id          String           @id @default(cuid())
  tenantId    String
  sectionId   String
  subjectId   String
  title       String
  description String
  assignedOn  DateTime
  dueOn       DateTime
  status      String // draft | published | withdrawn
  createdById String // User.id of the author
  authorName  String
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  rows        HomeworkStatus[]

  @@index([tenantId, sectionId, dueOn])
}

// Per-student completion, recorded by the teacher. A student with no row is "pending".
model HomeworkStatus {
  id         String   @id @default(cuid())
  tenantId   String
  homeworkId String
  studentId  String
  status     String // done | missing | excused
  note       String?
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([tenantId])
}
